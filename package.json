{
  "name": "postscript-annotation-app",
  "version": "1.0.0",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "svench": "SVENCH=1 nollup",
    "svench:rollup": "SVENCH=1 rollup -wc rollup.config.svench.js",
    "start": "sirv public --host"
  },
  "devDependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.14.5",
    "@babel/preset-env": "^7.14.7",
    "@babel/runtime": "^7.14.6",
    "@rollup/plugin-babel": "^5.3.0",
    "@rollup/plugin-commonjs": "^14.0.0",
    "@rollup/plugin-node-resolve": "^8.0.0",
    "corejs": "^1.0.0",
    "eslint": "^7.25.0",
    "eslint-plugin-svelte3": "^3.2.0",
    "husky": "^4.3.8",
    "lint-staged": "^10.5.4",
    "mdsvex": "^0.8.9",
    "prettier": "^2.4.1",
    "prettier-plugin-svelte": "^2.4.0",
    "rollup": "^2.45.2",
    "rollup-plugin-delete": "^2.0.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^6.1.1",
    "rollup-plugin-svelte-hot": "^0.12.0-0",
    "rollup-plugin-terser": "^7.0.0",
    "svelte": "^3.37.0",
    "svench": "0.2.0-14",
    "whatwg-fetch": "^3.6.2"
  },
  "dependencies": {
    "faunadb": "^3.0.1",
    "gotrue-js": "^0.9.29",
    "netlify-cli": "^4.0.5",
    "node-fetch": "^2.6.1",
    "sirv-cli": "^1.0.11",
    "stripe": "^8.145.0",
    "svelte-spa-router": "^3.1.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.{js,css,md,svelte}": "prettier --write --svelte-sort-order scripts-markup-styles ./**/*.svelte"
  }
}
