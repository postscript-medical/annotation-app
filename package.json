{
	"name": "postscript-annotation-app",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"prepare": "svelte-kit sync || echo ''; husky || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --project unit",
		"test:integration": "vitest --run --project integration",
		"test": "npm run test:unit -- --run && npm run test:integration && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:smoke": "playwright test -c playwright.smoke.config.ts",
		"check:scope": "sh scripts/check-removed-scope.sh",
		"db:types": "sh scripts/gen-db-types.sh",
		"check:db-types": "sh scripts/gen-db-types.sh --check",
		"env:local": "sh scripts/local-env.sh"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,css,html,md,yml,yaml}": "prettier --write"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@percy/cli": "^1.32.12",
		"@percy/playwright": "^1.1.2",
		"@playwright/test": "^1.60.0",
		"@storybook/addon-a11y": "^10.6.6",
		"@storybook/addon-docs": "^10.6.6",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/sveltekit": "^10.6.6",
		"@sveltejs/adapter-netlify": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"@types/nodemailer": "^8.0.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"storybook": "^10.6.6",
		"supabase": "^3.0.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.118.0",
		"gsap": "^3.15.0",
		"nodemailer": "^10.3.1",
		"zod": "^4.6.7"
	}
}
