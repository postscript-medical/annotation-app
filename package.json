{
  "name": "postscript-annotation-app",
  "version": "0.2.0",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "start": "sirv public --host",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "test": "percy exec -- npx playwright test",
    "test:dev": "npx playwright test --ui"
  },
  "devDependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.18.10",
    "@babel/preset-env": "^7.18.10",
    "@babel/runtime": "^7.18.9",
    "@percy/cli": "^1.26.2",
    "@percy/playwright": "^1.0.4",
    "@playwright/test": "^1.35.1",
    "@rollup/plugin-babel": "^5.3.1",
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "core-js": "^3.24.1",
    "eslint": "^8.21.0",
    "eslint-plugin-svelte3": "^4.0.0",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "mdsvex": "^0.10.6",
    "playwright": "^1.35.1",
    "prettier": "^2.7.1",
    "prettier-plugin-svelte": "^2.7.0",
    "rollup": "^2.77.2",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-delete": "^2.0.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-svelte": "^7.1.0",
    "rollup-plugin-svelte-hot": "^1.0.0-8",
    "rollup-plugin-terser": "^7.0.2",
    "svelte": "^3.49.0",
    "svelte-portal": "^2.2.0",
    "svelte-spa-router": "^3.3.0",
    "svelte-undo": "^1.0.2",
    "svench": "^0.3.0-1",
    "whatwg-fetch": "^3.6.2"
  },
  "dependencies": {
    "faunadb": "^4.6.0",
    "gotrue-js": "^0.9.29",
    "netlify-cli": "^10.15.0",
    "node-fetch": "^2.6.7",
    "postmark": "^3.0.12",
    "sirv-cli": "^2.0.2",
    "stripe": "^10.0.0"
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.{js,css,md,svelte}": "prettier --write --svelte-sort-order scripts-markup-styles ./**/*.svelte"
  }
}
