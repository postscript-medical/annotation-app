{
  "name": "svelte-app",
  "version": "1.0.0",
  "scripts": {
    "build": "rollup -c",
    "dev": "nollup",
    "dev:rollup": "rollup -c -w",
    "svench": "SVENCH=1 nollup",
    "svench:rollup": "SVENCH=1 rollup -wc rollup.config.svench.js",
    "start": "sirv public --host"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^14.0.0",
    "@rollup/plugin-node-resolve": "^8.0.0",
    "eslint": "^7.15.0",
    "eslint-plugin-svelte3": "^3.0.0",
    "husky": "^4.3.6",
    "lint-staged": "^10.5.3",
    "mdsvex": "^0.8.8",
    "prettier": "^2.2.1",
    "prettier-plugin-svelte": "^1.4.2",
    "rollup": "^2.3.4",
    "rollup-plugin-delete": "^2.0.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^6.0.0",
    "rollup-plugin-svelte-hot": "^0.12.0-0",
    "rollup-plugin-terser": "^7.0.0",
    "svelte": "^3.0.0",
    "svench": "0.0.10-7"
  },
  "dependencies": {
    "faunadb": "^3.0.1",
    "gotrue-js": "^0.9.27",
    "node-fetch": "^2.6.1",
    "sirv-cli": "^1.0.0",
    "stripe": "^8.96.0",
    "svelte-spa-router": "^3.1.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.{js,css,md,svelte}": "prettier --write --svelte-sort-order scripts-markup-styles ./**/*.svelte"
  }
}
