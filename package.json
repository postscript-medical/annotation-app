    "core-js": "^3.18.2",
    "eslint": "^7.32.0",
    "eslint-plugin-svelte3": "^3.2.1",
    "husky": "^7.0.0",
    "lint-staged": "^11.2.0",
    "mdsvex": "^0.9.8",
    "prettier": "^2.4.1",
    "prettier-plugin-svelte": "^2.4.0",
