{
  "name": "postscript-annotation-app",
  "version": "0.5.0",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "start": "sirv public --host",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "test": "percy exec -- npx playwright test",
    "test:dev": "npx playwright test --ui",
    "test:components": "playwright test --ui -c playwright-ct.config.ts"
  },
  "devDependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/runtime": "^7.24.7",
    "@percy/cli": "^1.28.7",
    "@percy/playwright": "^1.0.5",
    "@playwright/experimental-ct-svelte": "^1.44.1",
    "@playwright/test": "^1.44.1",
    "@rollup/plugin-babel": "^5.3.1",
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "core-js": "^3.37.1",
    "eslint": "^8.57.0",
    "eslint-plugin-svelte3": "^4.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "mdsvex": "^0.10.6",
    "playwright": "^1.35.1",
    "prettier": "^2.8.8",
    "prettier-plugin-svelte": "^2.10.1",
    "rollup": "^2.79.1",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-delete": "^2.0.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-svelte": "^7.2.2",
    "rollup-plugin-svelte-hot": "^1.0.0-8",
    "rollup-plugin-terser": "^7.0.2",
    "svelte": "^3.59.2",
    "svelte-spa-router": "^3.3.0",
    "whatwg-fetch": "^3.6.20"
  },
  "dependencies": {
    "faunadb": "^4.8.0",
    "gotrue-js": "^0.9.29",
    "netlify-cli": "^10.18.0",
    "node-fetch": "^2.7.0",
    "postmark": "^3.11.0",
    "sirv-cli": "^2.0.2",
    "stripe": "^10.17.0"
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.{js,css,md,svelte}": "prettier --write --svelte-sort-order scripts-markup-styles ./**/*.svelte"
  }
}
