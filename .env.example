# `npm run env:local` writes `.env` with these filled in from `npx supabase status` (`.env` is
# git-ignored). Declared and validated in src/env.ts. Never put staging or production secrets here.

# API_URL from `npx supabase status`
SUPABASE_URL=http://127.0.0.1:54321
# PUBLISHABLE_KEY from `npx supabase status`
SUPABASE_PUBLISHABLE_KEY=
# SECRET_KEY from `npx supabase status` (server only; bypasses RLS)
SUPABASE_SECRET_KEY=
# At least 32 random characters, e.g. `openssl rand -base64 32`. A different value per environment.
RATE_LIMIT_HMAC_SECRET=
# Feedback email (2.6) goes to the local Mailpit (web UI on 54324): no TLS, no login.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASSWORD=
FEEDBACK_TO=feedback@example.com

# The smoke suite (`npm run test:smoke`) reads these from a git-ignored .env.smoke, not from .env.
# SMOKE_EMAIL=
# SMOKE_PASSWORD=
# SMOKE_BASE_URL=https://staging.app.postscriptmedical.com
# SMOKE_SIGNED_OUT_ONLY=1
