# Copy to `.env` for local development (`.env` is git-ignored). Declared and validated in src/env.ts.
# Local Supabase values come from `npx supabase status`. Never put staging or production secrets here.

# API_URL from `npx supabase status`
SUPABASE_URL=http://127.0.0.1:54321
# PUBLISHABLE_KEY from `npx supabase status`
SUPABASE_PUBLISHABLE_KEY=
# SECRET_KEY from `npx supabase status` (server only; bypasses RLS)
SUPABASE_SECRET_KEY=
# At least 32 random characters, e.g. `openssl rand -base64 32`. A different value per environment.
RATE_LIMIT_HMAC_SECRET=
